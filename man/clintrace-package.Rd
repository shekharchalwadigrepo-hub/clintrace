\name{clintrace}
\alias{clintrace}
\alias{clintrace-package}
\title{Traceability and Lineage Tracking for Clinical Trial Data}
\description{
Tools for recording, querying, and reporting data lineage in clinical trial
programming workflows from SDTM to ADaM to TLF.
}
\details{
The package provides an S3 object of class \code{clintrace} that stores
lineage records. Core functions are \code{\link{new_trace}},
\code{\link{add_lineage}}, and \code{\link{query_lineage}}.
}
\author{Shekhar Eranna Chalwadi}
\keyword{package}
